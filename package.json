{
  "name": "jobhunt",
  "version": "1.6.0",
  "description": "AI-powered job search pipeline",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "app:web:dev": "npm run dev --workspace @jobhunt/web",
    "app:web:build": "npm run build --workspace @jobhunt/web",
    "app:web:check": "npm run check --workspace @jobhunt/web",
    "app:api:dev": "npm run dev --workspace @jobhunt/api",
    "app:api:build": "npm run build --workspace @jobhunt/api",
    "app:api:check": "npm run check --workspace @jobhunt/api",
    "app:api:serve": "npm run serve --workspace @jobhunt/api",
    "app:api:test": "npm run test --workspace @jobhunt/api",
    "app:api:test:agent-runtime": "npm run test:agent-runtime --workspace @jobhunt/api",
    "app:api:test:runtime": "npm run test:runtime-contract --workspace @jobhunt/api",
    "app:api:test:store": "npm run test:store-contract --workspace @jobhunt/api",
    "app:api:test:tools": "npm run test:tools --workspace @jobhunt/api",
    "app:check": "npm run app:web:check && npm run app:api:check",
    "app:build": "npm run app:web:build && npm run app:api:build",
    "app:boot:test": "node scripts/test-app-bootstrap.mjs",
    "app:validate": "npm run app:check && npm run app:api:test && npm run app:boot:test",
    "typecheck": "npm run app:check",
    "backup:run": "node --no-warnings=ExperimentalWarning scripts/backup-operational-store.mjs",
    "backup:install-cron": "node scripts/install-backup-cron.mjs",
    "cron:install": "node scripts/install-scan-cron.mjs",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write . && npm run format:shell",
    "format:check": "prettier --check . && npm run format:shell:check",
    "format:shell": "shfmt -w -i 2 -ci -sr batch/batch-runner.sh batch/test-fixtures/mock-codex-exec.sh scripts/analyze-project.sh scripts/run-scheduled-scan.sh scripts/ux.sh",
    "format:shell:check": "shfmt -d -i 2 -ci -sr batch/batch-runner.sh batch/test-fixtures/mock-codex-exec.sh scripts/analyze-project.sh scripts/run-scheduled-scan.sh scripts/ux.sh",
    "lint": "biome lint scripts apps && npm run lint:shell",
    "lint:shell": "shellcheck batch/batch-runner.sh batch/test-fixtures/mock-codex-exec.sh scripts/analyze-project.sh scripts/run-scheduled-scan.sh scripts/ux.sh",
    "test:quick": "node scripts/test-all.mjs --quick",
    "verify": "node scripts/verify-pipeline.mjs",
    "normalize": "node scripts/normalize-statuses.mjs",
    "dedup": "node scripts/dedup-tracker.mjs",
    "merge": "node scripts/merge-tracker.mjs",
    "status": "node scripts/set-status.mjs",
    "tracker:test": "node scripts/test-tracker-core.mjs",
    "report:reserve": "node scripts/reserve-report-ids.mjs",
    "report:reserve:test": "node scripts/test-report-reservations.mjs",
    "reconcile": "node scripts/reconcile-pipeline.mjs",
    "reconcile:test": "node scripts/test-reconcile-pipeline.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "pdf:validate": "node scripts/validate-pdf.mjs",
    "pdf:test": "node scripts/test-pdf-pipeline.mjs",
    "cv:build": "node scripts/build-cv.mjs",
    "cv:facts": "node scripts/verify-cv-facts.mjs",
    "cv:facts:test": "node scripts/test-verify-cv-facts.mjs",
    "jd:preflight": "node scripts/jd-skill-gap.mjs",
    "jd:preflight:test": "node scripts/test-jd-skill-gap.mjs",
    "evaluation:policy": "node scripts/evaluation-policy.mjs --json",
    "evaluation:validate": "node scripts/evaluation-summary.mjs",
    "evaluation:test": "node scripts/test-evaluation-summary.mjs",
    "model:evaluate": "node scripts/model-provider-runner.mjs",
    "model:runner:test": "node scripts/test-model-provider-runner.mjs",
    "evidence:reliability": "node scripts/evidence-reliability.mjs",
    "eval:golden": "node scripts/eval-golden.mjs --model=cheap-stub",
    "eval:golden:test": "node scripts/test-eval-golden.mjs",
    "tokens:report": "node scripts/token-usage.mjs --aggregate",
    "tokens:test": "node scripts/test-token-usage.mjs",
    "application:preflight": "node scripts/application-preflight.mjs",
    "application:answers": "node scripts/application-answers.mjs",
    "application:email": "node scripts/application-email.mjs",
    "inbound:match": "node scripts/inbound-match.mjs",
    "followup:seed": "node scripts/followup-seed.mjs",
    "application:add": "node scripts/add-application.mjs",
    "application:find": "node scripts/find-application.mjs",
    "titles:expand": "node scripts/expand-titles.mjs",
    "agent:inbox": "node scripts/agent-inbox.mjs",
    "interview:session": "node scripts/interview-session.mjs",
    "offer:prep": "node scripts/offer-prep.mjs",
    "salary:observations": "node scripts/salary-observations.mjs",
    "assessments": "node scripts/assessment-log.mjs",
    "upskill": "node scripts/upskill-report.mjs",
    "analytics": "node scripts/career-analytics.mjs",
    "locales:test": "node scripts/test-locale-parity.mjs",
    "container:test": "node scripts/test-container-contract.mjs",
    "container:smoke": "bash scripts/container-smoke.sh",
    "cover-letter": "node scripts/build-cover-letter.mjs",
    "cover-letter:validate": "node scripts/validate-cover-letter.mjs",
    "cover-letter:test": "node scripts/test-cover-letter.mjs",
    "templates:list": "node scripts/document-templates.mjs list",
    "templates:test": "node scripts/test-document-templates.mjs",
    "latex": "node scripts/generate-latex.mjs",
    "cv:latex": "node scripts/build-cv-latex.mjs",
    "cv:latex:test": "node scripts/test-build-cv-latex.mjs",
    "dashboard": "./scripts/ux.sh",
    "sync-check": "node scripts/cv-sync-check.mjs",
    "scan-state": "node scripts/manage-scan-state.mjs",
    "coverage:node": "c8 --all --src=scripts --report-dir=coverage/node --reporter=text-summary --reporter=lcov --reporter=json-summary --exclude=scripts/test-*.mjs --exclude=scripts/test-all.mjs node scripts/test-all.mjs --quick",
    "coverage:dashboard": "cd dashboard && go test ./... -covermode=atomic -coverprofile=coverage.out && go tool cover -func=coverage.out",
    "coverage:dashboard:html": "cd dashboard && go tool cover -html=coverage.out -o coverage.html",
    "coverage": "npm run coverage:node && npm run coverage:dashboard",
    "update:check": "node scripts/update-system.mjs check",
    "update": "node scripts/update-system.mjs apply",
    "rollback": "node scripts/update-system.mjs rollback",
    "liveness": "node scripts/check-liveness.mjs",
    "archive": "node scripts/archive-posting.mjs",
    "archive:test": "node scripts/test-archive-posting.mjs",
    "img-to-pdf": "node scripts/img-to-pdf.mjs",
    "img-to-pdf:test": "node scripts/test-img-to-pdf.mjs",
    "network:test": "node scripts/test-network-policy.mjs",
    "path:test": "node scripts/test-path-policy.mjs",
    "artifact:test": "node scripts/test-artifact-policy.mjs",
    "providers:test": "node scripts/test-providers.mjs",
    "scan:policy:test": "node scripts/test-scan-policy.mjs",
    "scan:ledger:test": "node scripts/test-scan-ledger.mjs",
    "fingerprint:test": "node scripts/test-fingerprint-core.mjs",
    "reposts": "node scripts/detect-reposts.mjs",
    "reposts:test": "node scripts/test-detect-reposts.mjs",
    "browser:extract:test": "node scripts/test-browser-extract.mjs",
    "liveness:api:test": "node scripts/test-liveness-api.mjs",
    "portals:validate": "node scripts/validate-portals.mjs",
    "portals:verify": "node scripts/verify-portals.mjs",
    "portals:test": "node scripts/test-portals-config.mjs",
    "scan:ats-full": "node scripts/scan-ats-full.mjs",
    "scan:ats-full:test": "node scripts/test-scan-ats-full.mjs",
    "safety:audit": "node scripts/audit-user-data.mjs",
    "safety:audit:test": "node scripts/test-audit-user-data.mjs",
    "extract-job": "node scripts/extract-job.mjs",
    "scan": "node scripts/scan.mjs",
    "auth:openai": "node scripts/openai-account-auth.mjs",
    "codex:smoke": "node scripts/openai-codex-smoke.mjs",
    "agents:codex:smoke": "node scripts/openai-agents-codex-smoke.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "js-yaml": "^5.2.2",
    "pdfjs-dist": "5.1.91",
    "playwright": "^1.59.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "c8": "^11.0.0",
    "prettier": "^3.9.4"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
