{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "linkedin": {
          "type": "string",
          "format": "uri"
        },
        "linkedinDisplay": {
          "type": "string",
          "minLength": 1
        },
        "portfolio": {
          "type": "string",
          "format": "uri"
        },
        "portfolioDisplay": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "email"],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "default": "en",
          "type": "string",
          "minLength": 2
        },
        "format": {
          "type": "string",
          "enum": ["letter", "a4"]
        },
        "jdText": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "type": "string",
                "enum": ["must-have", "nice-to-have"]
              },
              "status": {
                "type": "string",
                "enum": ["supported", "unsupported"]
              },
              "terms": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              },
              "includedSections": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "summary",
                    "competencies",
                    "experience",
                    "projects",
                    "education",
                    "certifications",
                    "skills"
                  ]
                }
              }
            },
            "required": [
              "id",
              "text",
              "importance",
              "status",
              "terms",
              "evidenceIds",
              "includedSections"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "company",
        "role",
        "language",
        "format",
        "jdText",
        "requirements"
      ],
      "additionalProperties": false
    },
    "labels": {
      "default": {
        "summary": "Professional Summary",
        "competencies": "Core Competencies",
        "experience": "Work Experience",
        "projects": "Projects",
        "education": "Education",
        "certifications": "Certifications",
        "skills": "Skills"
      },
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "competencies": {
          "type": "string",
          "minLength": 1
        },
        "experience": {
          "type": "string",
          "minLength": 1
        },
        "projects": {
          "type": "string",
          "minLength": 1
        },
        "education": {
          "type": "string",
          "minLength": 1
        },
        "certifications": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "competencies",
        "experience",
        "projects",
        "education",
        "certifications",
        "skills"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "summaryEvidenceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "competencies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": ["label", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "experience": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "bullets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  }
                }
              },
              "required": ["text", "evidenceIds"],
              "additionalProperties": false
            }
          }
        },
        "required": ["company", "role", "period", "bullets"],
        "additionalProperties": false
      }
    },
    "projects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "badge": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "technologies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": ["name", "description", "technologies", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "education": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": ["degree", "institution", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "certifications": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": ["name", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": ["category", "items", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sourceText": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "source", "sourceText"],
        "additionalProperties": false
      }
    },
    "sourceFiles": {
      "default": ["profile/cv.md", "config/profile.yml", "modes/_profile.md"],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "candidate",
    "job",
    "labels",
    "summary",
    "summaryEvidenceIds",
    "competencies",
    "experience",
    "projects",
    "education",
    "certifications",
    "skills",
    "evidence",
    "sourceFiles"
  ],
  "additionalProperties": false,
  "$id": "https://jobhunt.local/templates/cv-build.schema.json",
  "title": "jobhunt deterministic CV build"
}
