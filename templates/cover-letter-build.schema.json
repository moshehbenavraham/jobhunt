{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "linkedin": {
          "type": "string",
          "minLength": 1
        },
        "github": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "email"],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "language": {
          "default": "en",
          "type": "string",
          "minLength": 2
        },
        "format": {
          "default": "a4",
          "type": "string",
          "enum": ["letter", "a4"]
        },
        "jdText": {
          "type": "string",
          "minLength": 40
        }
      },
      "required": ["company", "role", "date", "language", "format", "jdText"],
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "explicit-user-request",
            "form-required",
            "form-optional",
            "strong-fit-policy"
          ]
        },
        "fieldStatus": {
          "type": "string",
          "enum": ["required", "optional", "not-present", "unknown"]
        }
      },
      "required": ["trigger", "fieldStatus"],
      "additionalProperties": false
    },
    "letter": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "minItems": 3,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["motivation", "evidence", "fit", "approach", "closing"]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidenceIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              }
            },
            "required": ["kind", "text", "evidenceIds"],
            "additionalProperties": false
          }
        },
        "signOff": {
          "default": "Sincerely,",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["greeting", "paragraphs", "signOff"],
      "additionalProperties": false
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "job.jd"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sourceText": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "source", "sourceText"],
        "additionalProperties": false
      }
    },
    "sourceFiles": {
      "default": ["profile/cv.md", "config/profile.yml", "modes/_profile.md"],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "default": {
        "humanReviewRequired": true
      },
      "type": "object",
      "properties": {
        "humanReviewRequired": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["humanReviewRequired"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "candidate",
    "job",
    "application",
    "letter",
    "evidence",
    "sourceFiles",
    "review"
  ],
  "additionalProperties": false,
  "$id": "https://jobhunt.local/templates/cover-letter-build.schema.json",
  "title": "jobhunt deterministic cover letter build"
}
